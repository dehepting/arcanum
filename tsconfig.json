{
  "compilerOptions": {
    // Target modern browsers
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",

    // React
    "jsx": "react-jsx",

    // CRITICAL: Allow gradual migration - JS and TS coexist
    "allowJs": true, // Can import .js files from .ts files
    "checkJs": false, // Don't type-check .js files (only .ts files)
    "noEmit": true, // Vite handles compilation, tsc only checks types

    // Strict mode - Enabled for maximum type safety
    "strict": true,

    // Quality of life
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,

    // Path aliases (optional, but useful)
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "mcp-server", "src-tauri"]
}
